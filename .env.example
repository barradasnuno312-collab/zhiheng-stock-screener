# Platform connection variables are pulled with lark-cli; do not commit .env.local.
FUYAO_API_KEY=
# Set true only after validating the real cumulative-report basis.
FUYAO_CUMULATIVE_VERIFIED=false
ZH_ACCESS_CODE=
# Independent high-entropy maintenance credential; never reuse the access code.
ZH_ADMIN_TOKEN=
ZH_AI_ENABLED=false
# Enable only after the cloud trigger binding and real execution have been verified.
ZH_SCHEDULE_ENABLED=false
